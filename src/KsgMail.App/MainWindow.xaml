<Window x:Class="KsgMail.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="KSG Mail — miesięczna wysyłka" Width="1180" Height="820"
 MinWidth="940" MinHeight="680" WindowStartupLocation="CenterScreen" Closing="OnClosing" ContentRendered="WindowContentRendered">
 <DockPanel Margin="22">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
   <StackPanel><TextBlock Text="KSG Mail" FontSize="28" FontWeight="SemiBold" Foreground="#173B69"/>
    <TextBlock Text="Dokumenty dla klientów · szyfrowany ZIP · miesięczna wysyłka" Foreground="#526477"/></StackPanel>
  </Grid>
  <Border DockPanel.Dock="Bottom" Background="#E5EDF6" Padding="12" Margin="0,14,0,0">
   <DockPanel><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Anuluj operację" Click="CancelOperation" IsEnabled="False"/>
    <TextBlock x:Name="StatusText" Text="Gotowy. Uzupełnij SMTP i dodaj klientów." VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
  </Border>
  <TabControl x:Name="Tabs">
   <TabItem Header="  Klienci  ">
    <Grid Margin="14">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
     <DockPanel Margin="0,0,18,0">
      <StackPanel DockPanel.Dock="Top">
       <WrapPanel>
        <Button Content="Nowy klient" Click="NewCustomer"/>
       </WrapPanel>
       <WrapPanel Margin="0,8,0,4">
        <TextBlock Text="Szukaj:" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBox x:Name="CustomerSearch" Width="220" TextChanged="CustomerFilterChanged" Margin="0,0,12,0"/>
        <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox x:Name="CustomerStateFilter" Width="125" SelectedIndex="0" SelectionChanged="CustomerFilterChanged">
         <ComboBoxItem Content="Wszystkie"/>
         <ComboBoxItem Content="Aktywne"/>
         <ComboBoxItem Content="Nieaktywne"/>
        </ComboBox>
        <TextBlock x:Name="CustomerCountText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#526477"/>
       </WrapPanel>
       <WrapPanel Margin="0,0,0,8">
        <Button Content="Zaznacz wszystkie widoczne" Click="SelectAllVisibleCustomers"/>
        <Button Content="Wyczyść zaznaczenie" Click="ClearCustomerSelection"/>
        <Button Content="Aktywuj zaznaczone" Click="ActivateSelectedCustomers"/>
        <Button Content="Dezaktywuj zaznaczone" Click="DeactivateSelectedCustomers"/>
        <Button Content="Usuń zaznaczone" Click="DeleteCustomer"/>
       </WrapPanel>
      </StackPanel>
      <DataGrid x:Name="CustomersGrid" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="CustomerSelected">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Klient" Binding="{Binding Name}" Width="*" MinWidth="160"/>
        <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="*" MinWidth="210"/>
        <DataGridCheckBoxColumn Header="Aktywny" Binding="{Binding Active}" Width="70"/>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
     <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <TextBlock Text="Konfiguracja klienta" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
       <TextBlock Text="Nazwa klienta"/><TextBox x:Name="CustomerName"/>
       <TextBlock Text="Adresy e-mail (oddziel średnikiem lub przecinkiem)"/><TextBox x:Name="CustomerEmail"/>
       <TextBlock Text="Możesz podać kilka adresów odbiorców dla jednego klienta." Foreground="#526477" Margin="0,0,0,8"/>
       <TextBlock Text="Temat wiadomości"/><TextBox x:Name="CustomerSubject"/>
       <TextBlock Text="Treść wiadomości"/><TextBox x:Name="CustomerBody" AcceptsReturn="True" Height="125" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
       <TextBlock Text="Zmienne: {klient} i {miesiac} (np. 2026-10)" Foreground="#526477" Margin="0,0,0,12"/>
       <TextBlock Text="Katalog z dokumentami (także podkatalogi)"/>
       <DockPanel><Button DockPanel.Dock="Right" Content="Wybierz…" Click="BrowseDirectory"/><TextBox x:Name="CustomerDirectory"/></DockPanel>
       <TextBlock x:Name="ZipPasswordLabel" Text="Hasło ZIP"/>
       <PasswordBox x:Name="CustomerPassword"/>
       <CheckBox x:Name="CustomerActive" Content="Klient aktywny" IsChecked="True" Margin="0,6,0,10"/>
       <Button Content="Zapisz klienta" Click="SaveCustomer" HorizontalAlignment="Left"/>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </TabItem>
   <TabItem Header="  SMTP i harmonogram  ">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <Grid Margin="22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="Serwer pocztowy" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
       <TextBlock Text="Host SMTP"/><TextBox x:Name="SmtpHost"/>
       <TextBlock Text="Port"/><TextBox x:Name="SmtpPort"/>
       <TextBlock Text="Bezpieczeństwo połączenia"/><ComboBox x:Name="SmtpSecurity" SelectedIndex="0"><ComboBoxItem Content="STARTTLS (zwykle 587)"/><ComboBoxItem Content="SSL/TLS (zwykle 465)"/></ComboBox>
       <TextBlock Text="Login SMTP"/><TextBox x:Name="SmtpUsername"/>
       <TextBlock x:Name="SmtpPasswordLabel" Text="Hasło SMTP"/><PasswordBox x:Name="SmtpPassword"/>
       <TextBlock Text="Adres e-mail nadawcy"/><TextBox x:Name="SenderEmail"/>
       <TextBlock Text="Nazwa nadawcy"/><TextBox x:Name="SenderName"/>
       <WrapPanel><Button Content="Zapisz konfigurację" Click="SaveSettings"/><Button Content="Test połączenia" Click="TestConnection"/></WrapPanel>
       <TextBlock Text="Test sprawdza TLS i logowanie. Nie wysyła wiadomości." TextWrapping="Wrap" Foreground="#526477"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
       <TextBlock Text="Limity i harmonogram" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
       <TextBlock Text="Maksymalny rozmiar ZIP (MB, 1–100)"/><TextBox x:Name="AttachmentLimit"/>
       <TextBlock Text="Maksymalny rozmiar plików źródłowych (MB, 1–2048)"/><TextBox x:Name="SourceLimit"/>
       <TextBlock Text="Liczba prób SMTP (1–5)"/><TextBox x:Name="RetryCount"/>
       <Separator Margin="0,14"/>
       <CheckBox x:Name="ScheduleEnabled" Content="Włącz automatyczną wysyłkę miesięczną" Margin="0,6,0,16"/>
       <TextBlock Text="Dzień miesiąca (1–28)"/><TextBox x:Name="ScheduleDay"/>
       <TextBlock Text="Godzina lokalna Windows (HH:mm)"/><TextBox x:Name="ScheduleTime"/>
       <TextBlock Text="Automatyczna wysyłka dotyczy aktywnych klientów i bieżącego miesiąca. Po terminie zadanie nadrabia wysyłkę po zalogowaniu. Komputer musi być włączony, a użytkownik zalogowany. Zapis konfiguracji tworzy zadanie Windows." TextWrapping="Wrap" Foreground="#526477" Margin="0,8"/>
       <TextBlock Text="Hasła SMTP i ZIP są szyfrowane dla bieżącego konta Windows. Puste pole przy edycji zachowuje zapisane hasło." TextWrapping="Wrap" Foreground="#526477" Margin="0,8"/>
      </StackPanel>
     </Grid>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="  Wysyłka i podgląd  ">
    <DockPanel Margin="14">
     <StackPanel DockPanel.Dock="Top">
      <WrapPanel VerticalAlignment="Center">
       <TextBlock Text="Okres (RRRR-MM)" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="Period" Width="100"/>
       <Button Content="Podgląd wszystkich aktywnych" Click="PreviewAll"/><Button Content="Podgląd wybranego klienta" Click="PreviewSelected"/>
      </WrapPanel>
      <CheckBox x:Name="AllowResend" IsChecked="True" IsEnabled="False"
                Content="Wysyłka ręczna zawsze ponownie sprawdza klientów i może wysyłać wielokrotnie w tym samym okresie"
                Margin="0,4,0,8"/>
      <WrapPanel Margin="0,0,0,8">
       <TextBlock Text="Szukaj w podglądzie:" VerticalAlignment="Center" Margin="0,0,6,0"/>
       <TextBox x:Name="PreviewSearch" Width="230" TextChanged="PreviewFilterChanged" Margin="0,0,14,0"/>
       <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,6,0"/>
       <ComboBox x:Name="PreviewStatusFilter" Width="165" SelectedIndex="0" SelectionChanged="PreviewFilterChanged">
        <ComboBoxItem Content="Wszystkie"/>
        <ComboBoxItem Content="Do wysłania"/>
        <ComboBoxItem Content="Błędy"/>
        <ComboBoxItem Content="Pominięte"/>
       </ComboBox>
       <TextBlock x:Name="PreviewCountText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#526477"/>
      </WrapPanel>
      <TextBlock Text="Podgląd tworzy dokładne archiwa, które zostaną wysłane. Filtry zmieniają tylko widok — nie ograniczają przygotowanej partii. Wybierz wiersz, aby zobaczyć treść i pliki." TextWrapping="Wrap" Foreground="#526477" Margin="0,0,0,10"/>
     </StackPanel>
     <WrapPanel DockPanel.Dock="Bottom"><Button x:Name="SendButton" Content="Wyślij przygotowane wiadomości…" Click="SendPrepared" IsEnabled="False"/><Button Content="Wyczyść podgląd" Click="ClearPreview"/></WrapPanel>
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="240"/></Grid.RowDefinitions>
      <DataGrid x:Name="PreviewGrid" SelectionMode="Single" SelectionChanged="PreviewSelectedMail">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Klient" Binding="{Binding Name}" Width="140"/>
        <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="180"/>
        <DataGridTextColumn Header="Pliki" Binding="{Binding FileCount}" Width="50"/>
        <DataGridTextColumn Header="ZIP" Binding="{Binding ZipSize}" Width="90"/>
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" MinWidth="300"/>
       </DataGrid.Columns>
      </DataGrid>
      <Grid Grid.Row="1" Margin="0,12,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <DockPanel><TextBlock x:Name="PreviewSubject" DockPanel.Dock="Top" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBox x:Name="PreviewBody" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></DockPanel>
       <DockPanel Grid.Column="2"><TextBlock Text="Pliki w ZIP" DockPanel.Dock="Top" FontWeight="SemiBold"/><ListBox x:Name="PreviewFiles" DisplayMemberPath="RelativePath" Margin="0,5,0,9"/></DockPanel>
      </Grid>
     </Grid>
    </DockPanel>
   </TabItem>
   <TabItem Header="  Aktualizacja  ">
    <StackPanel Margin="28" MaxWidth="680" HorizontalAlignment="Left">
     <TextBlock Text="Aktualizacja KSG Mail" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
     <TextBlock Text="Wersja zainstalowana"/><TextBlock x:Name="CurrentVersionText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <TextBlock Text="Najnowsza wersja na GitHub"/><TextBlock x:Name="LatestVersionText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
     <TextBlock x:Name="UpdateStatusText" Text="Sprawdzanie dostępności aktualizacji…" TextWrapping="Wrap" Foreground="#526477" Margin="0,0,0,16"/>
     <WrapPanel>
      <Button Content="Sprawdź aktualizacje" Click="CheckUpdates"/>
      <Button x:Name="InstallUpdateButton" Content="Pobierz i zainstaluj aktualizację" Click="InstallUpdate" IsEnabled="False"/>
     </WrapPanel>
     <TextBlock Text="Aktualizacje są pobierane wyłącznie z GitHub Releases repozytorium Pawel-sp9pw/ksg-mail. Przed uruchomieniem instalatora program sprawdza sumę SHA-256 z pliku SHA256SUMS.txt." TextWrapping="Wrap" Foreground="#526477" Margin="0,18,0,0"/>
    </StackPanel>
   </TabItem>
   <TabItem Header="  Historia wysyłek  ">
    <DockPanel Margin="14">
     <StackPanel DockPanel.Dock="Top">
      <WrapPanel>
       <Button Content="Odśwież" Click="RefreshLogs"/>
       <TextBlock Text="Ostatnie 1000 zdarzeń · czas lokalny" VerticalAlignment="Center"/>
      </WrapPanel>
      <WrapPanel Margin="0,8,0,8">
       <TextBlock Text="Firma:" VerticalAlignment="Center" Margin="0,0,6,0"/>
       <ComboBox x:Name="LogCustomerFilter" Width="260" SelectionChanged="LogCustomerFilterChanged"/>
       <TextBlock x:Name="LogCountText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#526477"/>
      </WrapPanel>
     </StackPanel>
     <DataGrid x:Name="LogsGrid">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Data" Binding="{Binding LocalTime}" Width="145"/>
       <DataGridTextColumn Header="Klient" Binding="{Binding CustomerName}" Width="130"/>
       <DataGridTextColumn Header="Okres" Binding="{Binding Period}" Width="75"/>
       <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
       <DataGridTextColumn Header="Informacja" Binding="{Binding Detail}" Width="*" MinWidth="400"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
